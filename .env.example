# ---------------------------------------------------------------------------
# LOCAL (a real SQLite file; never committed, it is listed in .gitignore)
# ---------------------------------------------------------------------------
DATABASE_URL=file:local.db

# ---------------------------------------------------------------------------
# PRODUCTION / VERCEL — Turso (hosted SQLite)
#   A local file does not work on Vercel (the filesystem resets on every deploy),
#   so set these two there:
# ---------------------------------------------------------------------------
# DATABASE_URL=libsql://<your-db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=<turso auth token>

# ---------------------------------------------------------------------------
# LOGIN (leave both empty and the site opens WITHOUT a password)
# ---------------------------------------------------------------------------
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASS=
