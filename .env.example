# ---------------------------------------------------------------------------
# LOCAL (asli SQLite file — repo me commit nahi hoti, .gitignore me hai)
# ---------------------------------------------------------------------------
DATABASE_URL=file:local.db

# ---------------------------------------------------------------------------
# PRODUCTION / VERCEL — Turso (hosted SQLite)
#   Vercel pe local file nahi chalti (filesystem har deploy pe reset hota hai),
#   isliye wahan ye do set karo:
# ---------------------------------------------------------------------------
# DATABASE_URL=libsql://<your-db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=<turso auth token>

# ---------------------------------------------------------------------------
# LOGIN (dono khali chhodoge to site BINA PASSWORD ke public rahegi)
# ---------------------------------------------------------------------------
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASS=
